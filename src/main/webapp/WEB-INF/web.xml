<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Medicine Availability Finder System</display-name>


    <!-- ============================= -->
    <!-- Welcome Page -->
    <!-- ============================= -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>


    <!-- ============================= -->
    <!-- Active User Listener -->
    <!-- Exercise 6c -->
    <!-- ============================= -->

    <listener>
        <listener-class>
            com.medicinefinder.listener.ActiveUserListener
        </listener-class>
    </listener>


    <!-- ============================= -->
    <!-- Login Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.LoginServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Register Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.RegisterServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Logout Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.LogoutServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Medicine Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>MedicineServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.MedicineServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MedicineServlet</servlet-name>
        <url-pattern>/medicine</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Cart Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.CartServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Feedback Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>FeedbackServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.FeedbackServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FeedbackServlet</servlet-name>
        <url-pattern>/feedback</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Session Timeout Servlet -->
    <!-- Exercise 6a -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>SessionTimeoutServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.SessionTimeoutServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SessionTimeoutServlet</servlet-name>
        <url-pattern>/sessionTimeout</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Visit Counter Servlet -->
    <!-- Exercise 6b -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>VisitCounterServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.VisitCounterServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VisitCounterServlet</servlet-name>
        <url-pattern>/visitCounter</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Active Users Servlet -->
    <!-- Exercise 6c -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>ActiveUsersServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.ActiveUsersServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ActiveUsersServlet</servlet-name>
        <url-pattern>/activeUsers</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- User Data Servlet -->
    <!-- Exercise 6d -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>UserDataServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.UserDataServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UserDataServlet</servlet-name>
        <url-pattern>/userData</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Delete Cookie Servlet -->
    <!-- Exercise 6e -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>DeleteCookieServlet</servlet-name>
        <servlet-class>
            com.medicinefinder.servlet.DeleteCookieServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteCookieServlet</servlet-name>
        <url-pattern>/deleteCookie</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Session Configuration -->
    <!-- Exactly 2 Minutes -->
    <!-- Exercise 6a -->
    <!-- ============================= -->

    <session-config>
        <session-timeout>2</session-timeout>
    </session-config>

</web-app>